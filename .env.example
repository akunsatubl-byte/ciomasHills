# Supabase Configuration
# Ganti nilai ini dengan credentials Supabase Anda
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Catatan:
# 1. Dapatkan URL & Anon Key dari Supabase Dashboard
# 2. Buat file .env.local dengan nilai yang sesuai
# 3. Jangan commit .env.local ke repository
# 4. Jika tidak set, aplikasi akan pakai fallback dummy data
